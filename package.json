{
  "name": "property-profit-au",
  "version": "1.0.0",
  "description": "An Australia-focused property sale profit estimator.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dairuifromcd/australian_property_sale_profit_estimator.git"
  },
  "bugs": {
    "url": "https://github.com/dairuifromcd/australian_property_sale_profit_estimator/issues"
  },
  "homepage": "https://github.com/dairuifromcd/australian_property_sale_profit_estimator#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "test": "npm run typecheck && npm run build && node --experimental-strip-types --test tests/calculator.test.ts tests/i18n.test.ts tests/rendered-html.test.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=app/calculator.ts --test-coverage-include=app/input-format.ts --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test tests/calculator.test.ts",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "typecheck": "tsc -p tsconfig.app.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.55",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
